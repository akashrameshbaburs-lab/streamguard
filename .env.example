# StreamGuard configuration — copy to .env and adjust.
# docker-compose reads .env automatically for ${VAR:-default} substitutions.

# --- simulator --------------------------------------------------------------
# Steady-state event rate of the long-running simulator container.
EVENTS_PER_SEC=20
# Fraction of injected fraud (velocity bursts, amount spikes, new-device, travel).
FRAUD_RATE=0.025

# --- scoring ----------------------------------------------------------------
# Alert when fused risk >= this threshold (0..1).
# Sweep-validated operating point (F1 peak 0.72-0.78, best precision near peak)
ALERT_THRESHOLD=0.75
# Fusion: risk = clip(max(rule, ML_WEIGHT*ml) + FUSION_GAMMA*min(rule, ml), 0, 1)
# ML_WEIGHT discounts the (noisier) model score; FUSION_GAMMA is the
# corroboration bonus when rules and model agree. See app/model.py::fuse_risk.
ML_WEIGHT=0.9
FUSION_GAMMA=0.15
# How often the consumer polls model_versions for a new model (seconds).
MODEL_POLL_SECONDS=3

# --- infrastructure ---------------------------------------------------------
PG_DSN=postgresql://streamguard:streamguard@postgres:5432/streamguard
AMQP_URL=amqp://streamguard:streamguard@rabbitmq:5672/

# --- training ---------------------------------------------------------------
# Rows of synthetic data generated per training run.
TRAIN_ROWS=50000
RANDOM_SEED=42
MODEL_DIR=/app/models

# --- notifications (optional — notifier stays healthy if unset) -------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
